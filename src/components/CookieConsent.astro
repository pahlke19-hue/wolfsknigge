---
// Schlankes, self-hosted Consent-Banner (Vanilla JS) + Google Consent Mode v2.
// GTM wird erst nach aktiver Einwilligung nachgeladen. GA4, Google Ads,
// Meta-Pixel + Microsoft Clarity werden als Tags IM GTM-Container verwaltet
// (über Consent gegated).
---

<div
  id="cookie-consent"
  class="hidden fixed inset-x-0 bottom-0 z-[100]"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie-Hinweis"
>
  <div class="max-w-[1100px] mx-auto m-2 sm:m-4 bg-anthrazit-2/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl p-4 sm:p-6">
    <div class="flex flex-col lg:flex-row lg:items-center gap-3 sm:gap-4">
      <div class="flex-1">
        <h2 class="text-white font-display font-bold text-[15px] sm:text-base mb-1">Cookies & Tracking</h2>
        <p class="text-white/55 text-[12.5px] sm:text-[13px] leading-snug sm:leading-relaxed">
          Ich nutze Google Analytics, Google Ads, Meta-Pixel und Microsoft Clarity, um die Website zu verbessern und Werbung zu messen. Nur mit deiner Einwilligung, jederzeit widerrufbar. Mehr in der <a href="/dsgvo/" class="text-orange hover:underline">Datenschutzerklärung</a>.
        </p>
      </div>
      <div class="grid grid-cols-2 sm:flex gap-2.5 shrink-0">
        <button
          id="cookie-decline"
          type="button"
          class="rounded-full bg-white/8 hover:bg-white/12 border border-white/12 text-white font-display font-semibold px-6 py-2.5 sm:py-3 text-sm transition-all"
        >
          Ablehnen
        </button>
        <button
          id="cookie-accept"
          type="button"
          class="shine rounded-full bg-orange hover:bg-orange-dark text-white font-display font-semibold px-6 py-2.5 sm:py-3 text-sm transition-all"
        >
          Akzeptieren
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const KEY = "wk-consent";
  const GTM_ID = "GTM-NQ89PJT2";
  const banner = document.getElementById("cookie-consent");
  const w = window as any;

  function gtag(...args: any[]) {
    (w.dataLayer = w.dataLayer || []).push(arguments);
  }

  function loadGTM() {
    if (w.__gtmLoaded) return;
    w.__gtmLoaded = true;
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      const f = d.getElementsByTagName(s)[0];
      const j = d.createElement(s) as HTMLScriptElement;
      const dl = l != "dataLayer" ? "&l=" + l : "";
      j.async = true;
      j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
      f.parentNode!.insertBefore(j, f);
    })(w, document, "script", "dataLayer", GTM_ID);
  }

  function grant() {
    gtag("consent", "update", {
      ad_storage: "granted",
      ad_user_data: "granted",
      ad_personalization: "granted",
      analytics_storage: "granted",
      functionality_storage: "granted",
      personalization_storage: "granted",
    });
    w.__consentGranted = true;
    loadGTM();
  }

  const show = () => banner?.classList.remove("hidden");
  const hide = () => banner?.classList.add("hidden");

  document.getElementById("cookie-accept")?.addEventListener("click", () => {
    localStorage.setItem(KEY, "granted");
    grant();
    hide();
  });

  document.getElementById("cookie-decline")?.addEventListener("click", () => {
    localStorage.setItem(KEY, "denied");
    gtag("consent", "update", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      functionality_storage: "denied",
      personalization_storage: "denied",
    });
    hide();
    // Widerrufs-Fall: War vorher eingewilligt, stoppt erst ein Reload einwilligungspflichtige Tags wirklich
    if (w.__consentGranted) location.reload();
  });

  // Widerruf / erneutes Öffnen (z.B. aus dem Footer)
  w.openCookieSettings = show;

  const saved = localStorage.getItem(KEY);
  if (saved === "granted") grant();
  else if (!saved) show();

  // Advanced Consent Mode: GTM laedt immer. Ohne Einwilligung bleiben alle Consent-Typen "denied",
  // Google-Tags senden dann nur cookielose Pings. Nicht-Google-Tags (Clarity, Meta) muessen in GTM
  // per "Zusaetzliche Einwilligung erforderlich" an analytics_storage/ad_storage gebunden sein.
  loadGTM();
</script>
