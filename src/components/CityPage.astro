---
interface Feature { text: string; bold?: string; }
interface Props {
  city: string;
  title: string;
  heroSubtitle: string;
  heroImage: string;
  features: Feature[];
  introH2: string;
  introParagraphs: string[];
  routeImage: string;
  routeImageAlt: string;
  anamneseText: string;
  anamneseAlt: string;
  einzelAlt: string;
  welpenText: string;
  welpenAlt: string;
  grundAlt: string;
  landingPage?: boolean;
}

const { landingPage = false, ...p } = Astro.props as Props;

const titleParts = {
  before: p.title.split('<span>')[0],
  highlight: p.title.includes('<span>') ? p.title.split('<span>')[1].split('</span>')[0] : '',
  after: p.title.includes('</span>') ? p.title.split('</span>')[1] : '',
};

// Symptom-Check (Reihenfolge = Hero-Chip-Deeplinks, wie Startseite)
const painPoints = [
  { id: "sym-leine", icon: '<path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/>', title: "Leinenpöbeln", text: "Kaum ein anderer Hund in Sicht und dein Hund dreht komplett durch. Jeder Spaziergang ein Nervenspiel." },
  { id: "sym-angst", icon: '<circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/>', title: "Angst und Panik", text: "Gewitter, Böller, fremde Menschen. Was für andere normal ist, löst bei deinem Hund puren Stress aus." },
  { id: "sym-rueckruf", icon: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/>', title: "Kein Rückruf", text: "Er kommt. Aber nur wenn er Lust hat. In dem Moment, wo es zählt, ist er weg." },
  { id: "sym-stadt", icon: '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>', title: "Reizüberflutung in der Stadt", text: "Radfahrer, Kinderwagen, Skater. Alles wird zum Trigger. Entspanntes Stadtleben? Fehlanzeige." },
  { id: "sym-basics", icon: '<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>', title: "Basics funktionieren nicht", text: "Sitz klappt zu Hause prima. Auf der Straße ist er wie ausgewechselt. Du weißt nicht warum." },
  { id: "sym-ersthund", icon: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>', title: "Überfordert als Ersthundebesitzer", text: "Niemand hat dir erklärt wie das wirklich geht. YouTube-Videos bringen dich nicht weiter." },
];

const vergleich = [
  { topic: "Trainingsort", hundeplatz: "Immer derselbe Hundeplatz", mobil: "Bei dir vor Ort. Dort, wo Probleme entstehen." },
  { topic: "Reizlage", hundeplatz: "Isoliert und eingezäunt", mobil: "Echter Alltag mit Joggern, Autos, anderen Hunden." },
  { topic: "Transfer", hundeplatz: "Funktioniert oft nur auf dem Platz", mobil: "Training findet direkt im Alltag statt." },
  { topic: "Betreuung", hundeplatz: "Große Gruppen, wenig Zeit pro Team", mobil: "1:1 oder kleine Gruppen. Voller Fokus." },
  { topic: "Methodik", hundeplatz: "Schema F für alle Hunde", mobil: "Individueller Plan nach moderner Lerntheorie." },
];

// Fahrplan (wie Startseite); Etappe 1 kostenlos
const prozess = [
  { step: "1", title: "Kennenlernen", text: "Kostenloses Erstgespräch per Telefon. Wir schauen, ob wir zueinander passen.", free: true },
  { step: "2", title: "Verhaltensanalyse", text: "Ausführliche Bestandsaufnahme bei dir vor Ort. Ich lerne euch im Alltag kennen." },
  { step: "3", title: "Klarer Fahrplan", text: "Ich gebe dir einen klaren, logisch aufgebauten Plan mit den ersten Trainingsschritten, damit ihr direkt loslegen könnt." },
  { step: "4", title: "Umsetzung", text: "Training dort, wo das Problem entsteht. Konsequent, fair, mit System." },
];

const testimonials = [
  { name: "Jori K.", text: "Die Trainingsanreize haben schnell geholfen und René nimmt sich wirklich Zeit für einen." },
  { name: "Susanne H.", text: "Als Ersthundebesitzer hatten wir viele Fragen, die uns schlüssig beantwortet wurden." },
  { name: "Daniela B.", text: "Dank des Trainings können wir endlich wieder entspannt Gassi gehen." },
  { name: "Jens", text: "Wir bekamen die Leinenaggression bei unserer Herdenschützerin super in den Griff." },
  { name: "Nicole H.", text: "Das Training hat schnell geholfen, sodass bei uns wieder Harmonie herrscht." },
  { name: "Sophia S.", text: "Dank des konsequenten Trainings klappt der Rückruf jetzt perfekt." },
  { name: "Mathias", text: "Wir lernen so viel Wichtiges, das uns super und schnell weiterhilft." },
  { name: "Claudia R.", text: "René hat uns geholfen, die Fehler im Umfeld zu sehen. Jetzt ist der Kleine entspannter." },
];

const allCities = [
  { city: "Kiel", href: "/hundeschule-kiel", text: "Kiellinie, Schrevenpark, Holtenauer.", image: "/images/hundeplatz_kiel.webp" },
  { city: "Rendsburg", href: "/hundeschule-rendsburg", text: "Nord-Ostsee-Kanal, Büdelsdorf, Fockbek.", image: "/images/rendsburg.webp" },
  { city: "Eckernförde", href: "/hundeschule-eckernfoerde", text: "Hafen, Promenade, Hundestrand.", image: "/images/social_walk_eckernfoerde.webp" },
  { city: "Neumünster", href: "/hundeschule-neumuenster", text: "Einfelder See, Stadtwald, Großflecken.", image: "/images/neumuenster.webp" },
];
const otherCities = allCities.filter((c) => c.city !== p.city);

const pressLogos = [
  { src: "/images/RTL_Nord_Logo.svg", alt: "RTL Nord", width: 120 },
  { src: "/images/Kieler_Nachrichten_Logo.svg", alt: "Kieler Nachrichten", width: 150 },
  { src: "/images/Landeszeitung_Logo.svg", alt: "Landeszeitung", width: 140 },
];

const faq = [
  {
    frage: `Ist mein Hund wirklich ein Fall für einen Trainer?`,
    antwort: "Kurze Antwort: Ja, wahrscheinlich. Viele Halter warten zu lange. Ob Leinenpöbeln, Angst oder einfach keine Basics - je früher du anfängst, desto einfacher wird es. Ein kurzes Telefonat kostet nichts und bringt Klarheit."
  },
  {
    frage: "Ich war schon woanders. Warum sollte das hier anders sein?",
    antwort: "Weil wir nicht auf einem Hundeplatz trainieren. Dein Hund lernt genau dort, wo das Problem auftaucht: in deiner Straße, deinem Park, deiner Stadt. Kein Übungsplatz-Effekt, kein Schema F. Was hier funktioniert, funktioniert im echten Leben."
  },
  {
    frage: "Mein Hund ist sehr aggressiv. Geht das überhaupt?",
    antwort: "Genau das ist mein Schwerpunkt. Ich habe mich auf Problemverhalten spezialisiert und jahrelang in diesem Bereich gearbeitet. Aggression hat immer eine Ursache. Die finden wir, und dann gehen wir systematisch ran."
  },
  {
    frage: "Was kostet das Kennenlerngespräch?",
    antwort: "Nichts. Das erste Gespräch ist kostenlos. Wir schauen gemeinsam, ob und wie ich euch helfen kann. Erst dann entscheidest du, ob du weitermachen möchtest."
  },
  {
    frage: `Kommst du auch wirklich nach ${p.city}?`,
    antwort: `Ja. Ich bin mobil in einem Umkreis von ca. 35 km rund um Bredenbek aktiv und ${p.city} liegt in meinem Einzugsgebiet. Ruf kurz an, wir klären die Details.`
  },
  {
    frage: "Wie lange dauert es, bis ich Ergebnisse sehe?",
    antwort: "Das hängt vom Problem und deiner Konsequenz ab. Erste Verbesserungen sind oft nach wenigen Einheiten spürbar. Tiefergehende Verhaltensänderungen brauchen Zeit. Ich sage dir nach der Verhaltensanalyse ehrlich, was realistisch ist."
  },
];

const icArrow = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>';
const icWa = '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.117 1.528 5.845L.057 23.428a.5.5 0 0 0 .614.614l5.638-1.47A11.934 11.934 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>';
---

<script type="application/ld+json" is:inline set:html={JSON.stringify({"@context":"https://schema.org","@type":"FAQPage",mainEntity:faq.map((f)=>({"@type":"Question",name:f.frage,acceptedAnswer:{"@type":"Answer",text:f.antwort}}))})} />

<!-- HERO -->
<section id="hero" class="relative overflow-clip" style="min-height: 72svh; background: #000;">

  <div class="absolute inset-0">
    <img
      src={p.heroImage}
      alt=""
      aria-hidden="true"
      id="hero-bg-img"
      fetchpriority="high"
      decoding="async"
      class="w-full h-full object-cover"
      style="object-position: center 30%; transform-origin: center; will-change: transform;"
      width="1920" height="1280"
    />
  </div>

  <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0b] via-[rgba(10,10,11,0.7)] to-[rgba(10,10,11,0.2)]"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-[rgba(10,10,11,0.85)] via-[rgba(10,10,11,0.3)] to-transparent"></div>
  <div class="absolute -top-[200px] right-[-100px] w-[600px] h-[600px] rounded-full pointer-events-none blob-float" style="background: radial-gradient(circle, rgba(249,115,22,.15), transparent 70%);"></div>

  <div class="relative flex flex-col justify-end" style="min-height: 72svh; padding-bottom: env(safe-area-inset-bottom, 0px);">
    <div class="w-full max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-12 pb-20 pt-32 lg:pb-28">

      <div class="hero-reveal inline-flex items-center gap-2.5 bg-white/8 backdrop-blur-md border border-white/12 text-white font-medium text-[13px] px-4 py-2 rounded-full mb-7">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-orange opacity-75 ping-slow"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-orange"></span>
        </span>
        Mobile Hundeschule {p.city} · Schleswig-Holstein
      </div>

      <h1 class="hero-reveal hero-reveal-d1 font-display font-extrabold tracking-[-0.03em] leading-[1.05] mb-7 text-white text-[clamp(1.75rem,4.5vw,3.75rem)] max-w-[1000px]">
        {titleParts.before}
        {titleParts.highlight && <span class="text-gradient-orange italic">{titleParts.highlight}</span>}
        {titleParts.after}
      </h1>

      <p class="hero-reveal hero-reveal-d2 text-[clamp(1rem,2vw,1.25rem)] text-white/70 mb-6 leading-relaxed max-w-[640px] font-light">
        {p.heroSubtitle}
      </p>

      <div id="hero-chips" class="hero-reveal hero-reveal-d2b mb-9">
        <span class="block text-white/45 text-[13px] font-light mb-2.5">Ich helfe dir bei:</span>
        <div class="flex flex-nowrap items-center gap-0.5 sm:gap-2.5">
          <a href="#sym-leine" class="inline-flex items-center gap-1.5 whitespace-nowrap bg-white/[0.06] backdrop-blur-md border border-white/10 text-white/85 font-medium text-[clamp(0.5rem,2.5vw,0.8125rem)] px-1.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full transition-colors hover:border-orange/50 hover:text-white">
            <span class="hidden sm:inline-block w-1.5 h-1.5 rounded-full bg-orange"></span>Leinenaggression
          </a>
          <a href="#sym-angst" class="inline-flex items-center gap-1.5 whitespace-nowrap bg-white/[0.06] backdrop-blur-md border border-white/10 text-white/85 font-medium text-[clamp(0.5rem,2.5vw,0.8125rem)] px-1.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full transition-colors hover:border-orange/50 hover:text-white">
            <span class="hidden sm:inline-block w-1.5 h-1.5 rounded-full bg-orange"></span>Angst
          </a>
          <a href="#sym-rueckruf" class="inline-flex items-center gap-1.5 whitespace-nowrap bg-white/[0.06] backdrop-blur-md border border-white/10 text-white/85 font-medium text-[clamp(0.5rem,2.5vw,0.8125rem)] px-1.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full transition-colors hover:border-orange/50 hover:text-white">
            <span class="hidden sm:inline-block w-1.5 h-1.5 rounded-full bg-orange"></span>Jagdverhalten
          </a>
          <a href="#sym-ersthund" class="inline-flex items-center gap-1.5 whitespace-nowrap bg-white/[0.06] backdrop-blur-md border border-white/10 text-white/85 font-medium text-[clamp(0.5rem,2.5vw,0.8125rem)] px-1.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full transition-colors hover:border-orange/50 hover:text-white">
            <span class="hidden sm:inline-block w-1.5 h-1.5 rounded-full bg-orange"></span>Welpenschule
          </a>
        </div>
      </div>

      <div class="hero-reveal hero-reveal-d3 flex flex-col sm:flex-row gap-3.5 mb-12">
        <a href={landingPage ? "#kontakt-formular" : "/kontakt"} class="shine group inline-flex items-center justify-center gap-2.5 rounded-full bg-orange text-white font-display font-semibold px-8 py-4 text-[15px] transition-all shadow-[0_0_60px_rgba(249,115,22,0.35)] active:scale-95 sm:hover:scale-[1.03] sm:hover:bg-orange-dark">
          Kostenloses Kennenlernen
          <svg class="w-[18px] h-[18px] sm:group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href={landingPage ? "#starter-paket" : "#angebote"} class="inline-flex items-center justify-center gap-2 rounded-full bg-white/6 backdrop-blur border border-white/15 text-white font-display font-semibold px-8 py-4 text-[15px] transition-all sm:hover:bg-white/12">
          {landingPage ? "Starter-Paket ansehen" : "Angebote ansehen"}
        </a>
      </div>

      <div class="hero-reveal hero-reveal-d4 flex items-center gap-8 pt-7 border-t border-white/8">
        <div>
          <div class="text-gradient-orange font-display font-extrabold text-2xl leading-none mb-0.5">
            <span class="hero-counter" data-target="200" data-suffix="+">200+</span>
          </div>
          <div class="text-[11px] text-white/55 uppercase tracking-[0.12em] font-medium">Glückliche Teams</div>
        </div>
        <div class="w-px h-9 bg-white/10"></div>
        <a href="https://g.page/r/Cd7XaBPmJ5fKEAE" target="_blank" rel="noopener noreferrer" aria-label="Google-Bewertungen von WolfsKnigge ansehen">
          <div class="flex items-center gap-2 mb-0.5">
            <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            <span class="text-gradient-orange font-display font-extrabold text-2xl leading-none hero-counter" data-target="5" data-decimal="1" data-suffix="">5,0</span>
            <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </div>
          <div class="text-[11px] text-white/55 uppercase tracking-[0.12em] font-medium">14 Bewertungen ↗</div>
        </a>
        <div class="w-px h-9 bg-white/10"></div>
        <div>
          <div class="font-display font-extrabold text-2xl text-white leading-none mb-0.5">
            &lt; 24<span class="text-orange">h</span>
          </div>
          <div class="text-[11px] text-white/55 uppercase tracking-[0.12em] font-medium">Antwortzeit</div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 right-6 sm:right-8 text-white/55 flex flex-col items-center gap-1.5">
    <div class="w-px h-10 bg-gradient-to-b from-transparent to-white/30 scroll-line-anim"></div>
  </div>
</section>


<!-- ============ TRAININGSROUTE (Journey) ============ -->
<div class="journey" id="journey">

  <div class="route" id="route" aria-hidden="true">
    <div class="route-track"></div>
    <div class="route-fill" id="routeFill"></div>
    <div class="route-head" id="routeHead"></div>
  </div>

  <!-- WP 1 · SYMPTOM-CHECK -->
  <section class="sec bg-2" id="probleme">
    <span class="node node-here" aria-hidden="true"></span>
    <div class="jc">
      <p class="tag reveal"><span class="tag-here">Ihr seid hier</span></p>
      <h2 class="sec-h reveal reveal-delay-1">Kommt dir das bekannt vor?</h2>
      <p class="sec-sub reveal reveal-delay-2">Tipp an, was bei euch los ist. Eins öffnet sich, das vorige klappt wieder zu.</p>

      <div class="syms reveal reveal-delay-2">
        {painPoints.map((pp) => (
          <details class="sym" name="symptom" id={pp.id}>
            <summary>
              <span class="sym-ic"><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" set:html={pp.icon}></svg></span>
              <span class="sym-t">{pp.title}</span>
              <span class="sym-x"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M12 4v16m8-8H4"/></svg></span>
            </summary>
            <div class="sym-body">
              <p>{pp.text}</p>
            </div>
          </details>
        ))}
      </div>

      <p class="sym-cta reveal reveal-delay-3">Euer Thema ist nicht dabei? <a href={landingPage ? "#kontakt-formular" : "/kontakt"}>Schreib mir kurz, wir klären das →</a></p>
    </div>
  </section>

  <!-- WP 2 · WARUM MOBIL -->
  <section class="sec bg-1" id="warum">
    <span class="node" aria-hidden="true"></span>
    <div class="jc">
      <p class="tag reveal">Worum's wirklich geht</p>
      <h2 class="quote reveal reveal-delay-1">Ein „Sitz" auf dem Hundeplatz bringt dir nichts, <span class="text-gradient-orange">wenn dein Hund im Alltag die Nerven verliert.</span></h2>
      <p class="sec-sub reveal reveal-delay-2">Echte Verhaltensprobleme lassen sich nicht auf einem isolierten Hundeplatz wegtrainieren. Wir gehen genau dorthin, wo es bei euch tatsächlich knirscht. In deiner Straße, deinem Park, deinem Alltag.</p>

      <div class="vs reveal reveal-delay-2">
        {vergleich.map((v) => (
          <div class="vs-row">
            <div class="vs-cell lose">
              <p class="vlabel">{v.topic}</p>
              <p class="vs-line"><svg class="x" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 16 16"><line x1="4" y1="4" x2="12" y2="12"/><line x1="12" y1="4" x2="4" y2="12"/></svg>{v.hundeplatz}</p>
            </div>
            <div class="vs-cell win">
              <p class="vlabel">{v.topic}</p>
              <p class="vs-line"><svg class="ok" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 16 16"><path d="M3 9l3.5 3.5L13 5"/></svg>{v.mobil}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WP 3 · TRAINER (SEO-Text city-spezifisch) -->
  <section class="sec bg-2" id="trainer">
    <span class="node" aria-hidden="true"></span>
    <div class="jc">
      <p class="tag reveal">Dein Trainer in {p.city}</p>
      <h2 class="sec-h city-h reveal reveal-delay-1" set:html={p.introH2}></h2>

      <div class="trainer">
        <figure class="trainer-photo reveal-scale">
          <img src={p.routeImage} alt={p.routeImageAlt} loading="lazy" width="600" height="750" />
          <figcaption class="tbadge">
            <div class="n text-gradient-orange">200+</div>
            <div class="l">Teams erfolgreich begleitet</div>
          </figcaption>
        </figure>
