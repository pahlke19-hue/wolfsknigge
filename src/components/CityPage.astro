<style>
  /* ============ TRAININGSROUTE (Journey) ============ */
  .journey {
    --rail-x: 22px;
    --content-off: 54px;
    --rail-gap: 32px;
    --sp: clamp(4.5rem, 15vw, 8rem);
    --pad-r: 20px;
    position: relative;
  }
  @media (min-width: 1200px) {
    .journey { --rail-x: calc(50% - 560px); --content-off: 92px; --rail-gap: 92px; }
  }
  .jc { max-width: 1120px; margin: 0 auto; padding-left: var(--content-off); padding-right: var(--pad-r); }

  .route { position: absolute; top: 0; left: var(--rail-x); width: 2px; transform: translateX(-50%); z-index: 5; pointer-events: none; }
  .route-track { position: absolute; inset: 0; background: repeating-linear-gradient(180deg, rgba(255,255,255,.16) 0 7px, transparent 7px 16px); }
  .route-fill { position: absolute; inset: 0; background: linear-gradient(180deg, var(--color-orange-glow), var(--color-orange)); box-shadow: 0 0 14px rgba(249,115,22,.55); transform: scaleY(0); transform-origin: top; }
  .route-head { position: absolute; top: -5px; left: 50%; width: 11px; height: 11px; border-radius: 50%; transform: translate(-50%, 0); background: var(--color-orange-glow); box-shadow: 0 0 16px rgba(249,115,22,.85), 0 0 4px rgba(251,146,60,.9); opacity: 0; }

  .sec { position: relative; padding: var(--sp) 0; }
  .bg-1 { background: var(--color-anthrazit); }
  .bg-2 { background: var(--color-anthrazit-2); }
  .node { position: absolute; left: var(--rail-x); top: calc(var(--sp) - 1px); width: 15px; height: 15px; border-radius: 50%; transform: translateX(-50%); background: var(--color-anthrazit-3); border: 2px solid rgba(255,255,255,.28); z-index: 6; transition: background .5s ease, border-color .5s ease, box-shadow .5s ease; }
  .node.lit { background: var(--color-orange); border-color: var(--color-orange-glow); box-shadow: 0 0 18px rgba(249,115,22,.75); }
  .node-here::after { content: ""; position: absolute; inset: -7px; border-radius: 50%; border: 2px solid rgba(54,255,243,.55); animation: wk-ping 2.4s cubic-bezier(0,0,.2,1) infinite; }
  .node-here.lit { background: var(--color-tuerkis); border-color: var(--color-tuerkis); box-shadow: 0 0 20px rgba(54,255,243,.8); }
  @keyframes wk-ping { 0% { transform: scale(.6); opacity: 1; } 80%, 100% { transform: scale(1.7); opacity: 0; } }
  .node-goal { position: absolute; left: var(--rail-x); top: calc(var(--sp) - 10px); transform: translateX(-50%); z-index: 6; color: rgba(255,255,255,.35); transition: color .5s ease, filter .5s ease; }
  .node-goal svg { width: 30px; height: 30px; display: block; }
  .node-goal.lit { color: var(--color-orange); filter: drop-shadow(0 0 14px rgba(249,115,22,.8)); }

  .tag { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 700; letter-spacing: 0.28em; text-transform: uppercase; color: var(--color-orange); margin-bottom: 18px; }
  .tag-here { display: inline-flex; align-items: center; gap: 8px; color: var(--color-tuerkis); }
  .tag-here::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--color-tuerkis); box-shadow: 0 0 10px var(--color-tuerkis); }
  .sec-h { font-size: clamp(1.85rem, 7vw, 3.3rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; color: #fff; margin-bottom: 16px; max-width: 21ch; }
  .city-h :global(span) { -webkit-background-clip: text; background-clip: text; color: transparent; background-image: linear-gradient(120deg, var(--color-orange-glow), var(--color-orange)); }
  .sec-sub { color: rgba(255,255,255,.7); font-size: clamp(.95rem, 2vw, 1.1rem); line-height: 1.65; max-width: 56ch; font-weight: 300; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; border-radius: 999px; font-family: var(--font-display); font-weight: 600; font-size: 15px; padding: 16px 28px; border: 0; cursor: pointer; transition: transform .25s ease, background .25s ease; }
  .btn:active { transform: scale(.96); }
  .btn svg { width: 18px; height: 18px; flex-shrink: 0; }
  .btn-orange { background: var(--color-orange); color: #fff; box-shadow: 0 0 50px rgba(249,115,22,.32); }
  .btn-orange:hover { background: var(--color-orange-dark); transform: scale(1.02); }
  .btn-wa { background: #25D366; color: #fff; box-shadow: 0 0 50px rgba(37,211,102,.22); }
  .btn-wa:hover { background: #1ebe5d; transform: scale(1.02); }

  /* Symptom-Check */
  .syms { display: flex; flex-direction: column; gap: 10px; margin-top: 34px; max-width: 760px; }
  .sym { background: var(--color-anthrazit-3); border: 1px solid rgba(255,255,255,.06); border-radius: 18px; overflow: clip; transition: border-color .3s ease; }
  .sym[open] { border-color: rgba(249,115,22,.4); }
  .sym summary { display: flex; align-items: center; gap: 14px; padding: 17px 18px; cursor: pointer; list-style: none; font-family: var(--font-display); font-weight: 600; font-size: 15.5px; color: #fff; }
  .sym summary::-webkit-details-marker { display: none; }
  .sym-ic { flex-shrink: 0; width: 38px; height: 38px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: rgba(249,115,22,.1); border: 1px solid rgba(249,115,22,.22); color: var(--color-orange); }
  .sym-ic svg { width: 19px; height: 19px; }
  .sym-t { flex: 1; }
  .sym-x { flex-shrink: 0; color: rgba(255,255,255,.4); transition: transform .3s ease, color .3s ease; }
  .sym-x svg { width: 18px; height: 18px; display: block; }
  .sym[open] .sym-x { transform: rotate(45deg); color: var(--color-orange); }
  .sym-body { padding: 0 18px 20px 70px; }
  .sym-body p { color: rgba(255,255,255,.72); font-size: 14px; line-height: 1.65; }
  @media (max-width: 520px) { .sym-body { padding-left: 18px; } }
  .sym-cta { margin-top: 26px; font-size: 14.5px; color: rgba(255,255,255,.7); }
  .sym-cta a { color: var(--color-orange); font-weight: 600; font-family: var(--font-display); }
  .sym-cta a:hover { color: var(--color-orange-glow); }

  /* Warum mobil */
  .quote { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.03em; line-height: 1.08; font-size: clamp(1.7rem, 6.4vw, 3rem); color: #fff; max-width: 24ch; margin-bottom: 18px; }
  .vs { margin-top: 40px; display: flex; flex-direction: column; gap: 2px; border-radius: 20px; overflow: clip; max-width: 860px; }
  .vs-row { display: grid; grid-template-columns: 1fr 1fr; background: var(--color-anthrazit-3); }
  .vs-cell { padding: 16px 16px 18px; }
  .vs-cell .vlabel { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; margin-bottom: 7px; color: rgba(255,255,255,.3); }
  .vs-cell.win { background: linear-gradient(135deg, rgba(249,115,22,.1), rgba(249,115,22,.02)); }
  .vs-cell.win .vlabel { color: var(--color-orange); }
  .vs-line { display: flex; gap: 9px; align-items: flex-start; font-size: 13.5px; line-height: 1.5; }
  .vs-cell.lose { border-right: 1px solid rgba(255,255,255,.05); }
  .vs-cell.lose .vs-line { color: rgba(255,255,255,.5); }
  .vs-cell.win .vs-line { color: #fff; font-weight: 500; }
  .vs-line svg { width: 15px; height: 15px; flex-shrink: 0; margin-top: 2px; }
  .vs-line .x { color: rgba(255,255,255,.28); }
  .vs-line .ok { color: var(--color-orange); }

  /* Trainer */
  .trainer { display: grid; gap: 34px; margin-top: 8px; }
  @media (min-width: 880px) { .trainer { grid-template-columns: minmax(0,5fr) minmax(0,6fr); gap: 60px; align-items: center; } }
  .trainer-photo { position: relative; border-radius: 26px; overflow: clip; border: 1px solid rgba(255,255,255,.09); box-shadow: 0 30px 80px rgba(0,0,0,.5); margin: 0; }
  .trainer-photo img { width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: center 15%; }
  .trainer-photo .tbadge { position: absolute; right: 14px; bottom: 14px; background: rgba(20,20,22,.9); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,.1); border-radius: 16px; padding: 13px 16px; }
  .trainer-photo .tbadge .n { font-family: var(--font-display); font-weight: 800; font-size: 24px; line-height: 1; }
  .trainer-photo .tbadge .l { font-size: 11px; color: rgba(255,255,255,.5); margin-top: 4px; }
  .trainer-txt p { color: rgba(255,255,255,.7); line-height: 1.7; font-size: 15.5px; margin-bottom: 14px; }
  .trainer-txt p strong { color: #fff; font-weight: 600; }
  .trainer-txt a { color: var(--color-orange); font-weight: 500; text-decoration: underline; text-underline-offset: 4px; }
  .trainer-txt a:hover { color: var(--color-orange-dark); }
  .creds { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 20px; }
  .cred { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 600; color: rgba(255,255,255,.85); background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.11); border-radius: 999px; padding: 8px 14px; }
  .cred svg { width: 14px; height: 14px; color: var(--color-orange); }
  .trainer-more { display: inline-block; color: var(--color-orange); font-weight: 600; font-family: var(--font-display); font-size: 15px; text-decoration: none !important; }
  .trainer-more:hover { color: var(--color-orange-glow); }
  .press { margin-top: 30px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.07); }
  .press .plabel { font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: rgba(255,255,255,.35); font-weight: 700; margin-bottom: 14px; }
  .press-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .press-chip { display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,.92); border-radius: 10px; padding: 9px 14px; box-shadow: 0 6px 20px rgba(0,0,0,.25); }
  .press-chip img { height: 22px; width: auto; display: block; }
  @media (min-width: 880px) { .press-chip img { height: 26px; } }

  /* Features (city-spezifisch) */
  .feats { margin-top: 34px; display: grid; gap: 12px; }
  @media (min-width: 720px) { .feats { grid-template-columns: repeat(2, 1fr); } }
  .feat { position: relative; background: var(--color-anthrazit-3); border: 1px solid rgba(255,255,255,.06); border-radius: 18px; padding: 22px 20px; overflow: clip; transition: border-color .3s ease, transform .3s ease; }
  .feat:hover { border-color: rgba(249,115,22,.3); transform: translateY(-2px); }
  .feat .fnr { position: absolute; bottom: -14px; right: 4px; font-family: var(--font-display); font-weight: 800; font-size: 4.5rem; line-height: 1; color: rgba(255,255,255,.04); pointer-events: none; }
  .feat .fcheck { display: block; color: var(--color-orange); font-weight: 800; font-size: 18px; margin-bottom: 8px; position: relative; }
  .feat h3 { font-size: 17px; color: #fff; margin-bottom: 8px; position: relative; }
  .feat p { font-size: 13.5px; color: rgba(255,255,255,.6); line-height: 1.6; position: relative; }

  /* Fahrplan (Etappen auf der Route) */
  .etappen { margin-top: 44px; display: flex; flex-direction: column; gap: 42px; max-width: 640px; }
  .et { position: relative; }
  .et-num { position: absolute; left: calc(-1 * var(--rail-gap)); top: -4px; transform: translateX(-50%); width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 800; font-size: 16px; color: #fff; background: linear-gradient(135deg, var(--color-orange), var(--color-orange-dark)); box-shadow: 0 0 0 6px var(--color-anthrazit), 0 0 34px rgba(249,115,22,.4); z-index: 6; }
  .et h3 { font-size: 19px; color: #fff; margin-bottom: 7px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .et .free { font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #67e8f9; background: rgba(54,255,243,.08); border: 1px solid rgba(54,255,243,.25); border-radius: 999px; padding: 4px 10px; }
  .et p { color: rgba(255,255,255,.7); font-size: 14.5px; line-height: 1.65; max-width: 48ch; }

  /* Angebote */
  .offer-duo { margin-top: 34px; display: grid; gap: 12px; }
  @media (min-width: 880px) { .offer-duo { grid-template-columns: 1fr 1fr; align-items: stretch; } }
  .offer-feat { display: flex; flex-direction: column; background: var(--color-anthrazit-3); border: 1px solid rgba(249,115,22,.28); border-radius: 22px; overflow: clip; box-shadow: 0 24px 60px rgba(0,0,0,.4); transition: transform .3s ease, border-color .3s ease; }
  .offer-feat:hover { transform: translateY(-3px); border-color: rgba(249,115,22,.55); }
  .of-img { position: relative; }
  .of-img img { width: 100%; height: 100%; min-height: 190px; max-height: 240px; object-fit: cover; }
  .of-badge { position: absolute; top: 14px; left: 14px; background: var(--color-orange); color: #fff; font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; border-radius: 999px; padding: 7px 13px; box-shadow: 0 6px 24px rgba(249,115,22,.45); }
  .of-body { padding: 22px 20px 24px; display: flex; flex-direction: column; align-items: flex-start; flex: 1; }
  .of-badge-static { position: static; margin-bottom: 14px; }
  .of-sub { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--color-orange-glow); font-weight: 700; margin-bottom: 8px; }
  .of-body h3 { font-size: clamp(1.35rem, 4.5vw, 1.75rem); color: #fff; margin-bottom: 10px; }
  .of-txt { color: rgba(255,255,255,.7); font-size: 14px; line-height: 1.6; margin-bottom: 16px; }
  .of-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; list-style: none; padding: 0; }
  .of-list li { display: flex; align-items: baseline; gap: 9px; font-size: 13.5px; color: rgba(255,255,255,.82); }
  .of-list li::before { content: "✓"; color: var(--color-orange); font-weight: 800; font-size: 13px; flex-shrink: 0; }
  .of-list li strong { color: #fff; font-weight: 600; display: block; }
  .offer-pkg { background: linear-gradient(160deg, rgba(249,115,22,.09), var(--color-anthrazit-3)); border-color: rgba(249,115,22,.45); }
  .of-price { display: flex; align-items: baseline; gap: 10px; margin-top: auto; margin-bottom: 16px; }
  .of-price .p { font-family: var(--font-display); font-weight: 800; font-size: 28px; color: #fff; }
  .of-price .u { font-size: 12.5px; color: rgba(255,255,255,.5); }
  .of-price .statt { font-size: 14px; color: rgba(255,255,255,.4); text-decoration: line-through; }
  .of-price .save { font-size: 11px; font-weight: 700; color: var(--color-tuerkis); background: rgba(54,255,243,.08); border: 1px solid rgba(54,255,243,.25); border-radius: 999px; padding: 3px 9px; }
  .of-cta { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-weight: 600; font-size: 14px; color: var(--color-orange); }
  .of-cta svg { width: 16px; height: 16px; stroke-width: 2.5; }
  .offer-feat:hover .of-cta { color: var(--color-orange-glow); }

  .offers { margin-top: 12px; display: grid; gap: 10px; }
  @media (min-width: 720px) { .offers { grid-template-columns: repeat(3, 1fr); } }
  .offer { display: flex; align-items: center; gap: 13px; background: var(--color-anthrazit-3); border: 1px solid rgba(255,255,255,.06); border-radius: 16px; padding: 11px; transition: border-color .3s ease, transform .3s ease; }
  .offer:hover { border-color: rgba(249,115,22,.4); transform: translateY(-2px); }
  .offer img { width: 66px; height: 66px; border-radius: 12px; object-fit: cover; flex-shrink: 0; }
  .offer .ot { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .offer .on { font-family: var(--font-display); font-weight: 700; font-size: 15px; color: #fff; margin-bottom: 2px; }
  .offer .os { font-size: 12px; color: rgba(255,255,255,.55); }
  .offer .op { font-family: var(--font-display); font-weight: 700; font-size: 14px; color: var(--color-orange-glow); white-space: nowrap; }
  .offer .oarr { color: rgba(255,255,255,.3); flex-shrink: 0; }
  .offer .oarr svg { width: 16px; height: 16px; display: block; }
  .offers-more { margin-top: 18px; font-size: 14.5px; }
  .offers-more a { color: var(--color-orange); font-weight: 600; font-family: var(--font-display); }
  .offers-more a:hover { color: var(--color-orange-glow); }

  /* Starter-Paket (Landingpage) */
  .starter { margin-top: 34px; display: grid; gap: 2px; border-radius: 24px; overflow: clip; max-width: 900px; box-shadow: 0 24px 60px rgba(0,0,0,.4); }
  @media (min-width: 820px) { .starter { grid-template-columns: 7fr 5fr; } }
  .starter-main { background: var(--color-anthrazit-3); padding: 30px 26px; }
  .starter-main h3 { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.4rem, 4vw, 1.9rem); color: #fff; margin-bottom: 12px; }
  .starter-lead { color: rgba(255,255,255,.65); font-size: 14px; line-height: 1.6; margin-bottom: 18px; }
  .starter-price { background: linear-gradient(160deg, rgba(249,115,22,.1), var(--color-anthrazit-3)); border-top: 1px solid rgba(255,255,255,.06); padding: 32px 26px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  @media (min-width: 820px) { .starter-price { border-top: 0; border-left: 1px solid rgba(255,255,255,.06); } }
  .sp-label { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.5); font-weight: 700; margin-bottom: 8px; }
  .sp-amount { font-family: var(--font-display); font-weight: 800; font-size: clamp(3rem, 12vw, 4rem); color: #fff; line-height: 1; display: inline-flex; align-items: baseline; gap: 4px; }
  .sp-amount span { font-size: 1.75rem; }
  .sp-statt { color: var(--color-orange); text-decoration: line-through; font-size: 13.5px; margin: 8px 0 22px; }
  .sp-cta { width: 100%; }
  .sp-note { font-size: 11px; color: rgba(255,255,255,.3); margin-top: 16px; line-height: 1.5; }

  /* Stimmen */
  .tst-track { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-padding-left: var(--content-off); margin-top: 34px; padding: 4px var(--pad-r) 8px var(--content-off); }
  .tst-track::-webkit-scrollbar { display: none; }
  .tst { flex-shrink: 0; width: min(76vw, 330px); scroll-snap-align: start; background: var(--color-anthrazit-3); border: 1px solid rgba(255,255,255,.06); border-radius: 20px; padding: 20px; display: flex; flex-direction: column; gap: 12px; }
  .tst .stars { color: #facc15; font-size: 12px; letter-spacing: 2px; }
  .tst p { color: rgba(255,255,255,.78); font-size: 14.5px; line-height: 1.6; flex: 1; }
  .tst .who { display: flex; align-items: center; gap: 10px; }
  .tst .ava { width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0; background: rgba(249,115,22,.14); border: 1px solid rgba(249,115,22,.3); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: 13px; color: var(--color-orange); }
  .tst .who span { font-size: 13px; font-weight: 600; color: #fff; }
  .tst-g { background: linear-gradient(160deg, var(--color-anthrazit-3), #17181c); border-color: rgba(255,255,255,.1); align-items: flex-start; }
  .tst-g .gscore { display: flex; align-items: center; gap: 10px; }
  .tst-g .gscore .num { font-family: var(--font-display); font-weight: 800; font-size: 34px; color: #fff; }
  .tst-g .glink { font-size: 13px; font-weight: 600; color: var(--color-orange); }
  .tst-g .glink:hover { color: var(--color-orange-glow); }
  .tst-hint { margin-top: 14px; font-size: 12px; color: rgba(255,255,255,.35); display: flex; align-items: center; gap: 6px; }
  .belt { margin-top: 40px; background: var(--color-orange); border-radius: 20px; display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; padding: 20px 8px; color: #fff; max-width: 860px; }
  .belt > div + div { border-left: 1px solid rgba(255,255,255,.25); }
  .belt .n { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.3rem, 4.5vw, 1.8rem); line-height: 1; }
  .belt .l { font-size: 10.5px; text-transform: uppercase; letter-spacing: .1em; font-weight: 700; color: rgba(255,255,255,.8); margin-top: 6px; }

  /* Strecke */
  .area { display: grid; gap: 30px; margin-top: 36px; }
  @media (min-width: 880px) { .area { grid-template-columns: minmax(0,5fr) minmax(0,6fr); align-items: center; gap: 56px; } }
  .map-card { background: radial-gradient(ellipse at center, #17181c, var(--color-anthrazit-2)); border: 1px solid rgba(255,255,255,.08); border-radius: 24px; padding: 14px; }
  .map-card svg { width: 100%; height: auto; display: block; }
  .map-note { text-align: center; font-size: 12px; color: rgba(255,255,255,.45); padding: 4px 0 8px; }
  .cities { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .city { position: relative; border-radius: 18px; overflow: clip; aspect-ratio: 4/4.6; border: 1px solid rgba(255,255,255,.06); transition: transform .35s ease; }
  .city:hover { transform: translateY(-3px); }
  .city img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .7s ease; }
  .city:hover img { transform: scale(1.06); }
  .city .shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,10,11,.92) 8%, rgba(10,10,11,.32) 55%, transparent); }
  .city .ct { position: absolute; inset-inline: 0; bottom: 0; padding: 14px; }
  .city .ct h3 { font-size: 19px; color: #fff; }
  .city .ct p { font-size: 11.5px; color: rgba(255,255,255,.65); margin-top: 3px; }
  .city .ct .go { font-size: 12px; color: var(--color-orange-glow); font-weight: 600; margin-top: 7px; display: inline-block; }

  /* FAQ */
  .faqs { margin-top: 34px; display: flex; flex-direction: column; gap: 10px; max-width: 760px; }
  .faq { background: var(--color-anthrazit-3); border: 1px solid rgba(255,255,255,.06); border-radius: 18px; overflow: clip; transition: border-color .3s ease; }
  .faq[open] { border-color: rgba(249,115,22,.35); }
  .faq summary { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 17px 18px; cursor: pointer; list-style: none; font-family: var(--font-display); font-weight: 600; font-size: 15px; color: #fff; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq[open] summary { color: var(--color-orange-glow); }
  .faq summary svg { width: 17px; height: 17px; flex-shrink: 0; color: rgba(255,255,255,.4); transition: transform .3s ease; }
  .faq[open] summary svg { transform: rotate(45deg); color: var(--color-orange); }
  .faq .fa { padding: 0 18px 19px; color: rgba(255,255,255,.68); font-size: 14px; line-height: 1.7; }

  /* ZIEL */
  .ziel { position: relative; padding: var(--sp) 0 calc(var(--sp) + 40px); overflow: clip; }
  .ziel .halo { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 40%, rgba(249,115,22,.16), transparent 62%); }
  .ziel-h { font-size: clamp(2.3rem, 9.5vw, 4.6rem); font-weight: 800; letter-spacing: -0.04em; line-height: .98; color: #fff; margin-bottom: 18px; }
  .ziel .zsub { color: rgba(255,255,255,.7); font-size: clamp(.95rem, 2.2vw, 1.2rem); font-weight: 300; line-height: 1.65; max-width: 46ch; margin-bottom: 30px; }
  .ziel-ctas { display: flex; flex-direction: column; gap: 11px; max-width: 420px; }
  @media (min-width: 880px) { .ziel-ctas { flex-direction: row; max-width: none; } }
  .ziel-alt { margin-top: 18px; font-size: 14px; color: rgba(255,255,255,.55); }
  .ziel-alt a { color: #fff; font-weight: 600; border-bottom: 1px solid rgba(249,115,22,.5); }
  .ziel-alt a:hover { color: var(--color-orange-glow); }
  .ziel-trust { margin-top: 26px; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 12.5px; color: rgba(255,255,255,.5); }
  .ziel-trust span { display: inline-flex; align-items: center; gap: 7px; }
  .ziel-trust svg { width: 14px; height: 14px; color: var(--color-orange); }

  /* Kontakt-Formular (Landingpage) */
  .form-wrap { max-width: 720px; }
  .cform { margin-top: 30px; display: flex; flex-direction: column; gap: 18px; }
  .frow { display: grid; grid-template-columns: 1fr; gap: 18px; }
  @media (min-width: 560px) { .frow { grid-template-columns: 1fr 1fr; } }
  .fdivide { border-top: 1px solid rgba(255,255,255,.07); padding-top: 22px; }
  .cform label { display: block; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.6); margin-bottom: 8px; }
  .cform input[type="text"], .cform input[type="tel"], .cform input[type="email"], .cform textarea { width: 100%; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.1); border-radius: 12px; padding: 13px 15px; color: #fff; font-size: 14px; transition: border-color .25s ease; }
  .cform input::placeholder, .cform textarea::placeholder { color: rgba(255,255,255,.2); }
  .cform input:focus, .cform textarea:focus { outline: none; border-color: rgba(249,115,22,.5); }
  .cform textarea { line-height: 1.6; resize: vertical; }
  .fdsgvo { display: flex; align-items: flex-start; gap: 12px; }
  .fdsgvo input { margin-top: 3px; accent-color: var(--color-orange); flex-shrink: 0; }
  .fdsgvo label { font-size: 12px; font-weight: 400; letter-spacing: 0; text-transform: none; color: rgba(255,255,255,.55); line-height: 1.6; margin-bottom: 0; }
  .fdsgvo a { color: var(--color-orange); text-decoration: underline; }
  .fdsgvo a:hover { color: var(--color-orange-glow); }
  .fsubmit { width: 100%; margin-top: 4px; }

  /* Motion-Sicherheit */
  @media (prefers-reduced-motion: reduce) {
    .route-fill { transform: scaleY(1) !important; }
    .route-head { display: none; }
    .node-here::after { animation: none; }
  }

  /* city-prose (SEO-Absätze: strong weiß, em orange) */
  .city-prose :global(strong) { color: #ffffff; font-weight: 600; }
  .city-prose :global(em) { color: #f97316; font-style: normal; font-weight: 600; }
</style>

<script>
  // Hero-Reveal, Parallax, Zähler
  (() => {
    const els = document.querySelectorAll<HTMLElement>('.hero-reveal');
    els.forEach((el) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(28px)';
    });

    const animate = () => {
      els.forEach((el) => {
        el.style.transition = 'opacity 1s cubic-bezier(0.16,1,0.3,1), transform 1s cubic-bezier(0.16,1,0.3,1)';
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => requestAnimationFrame(() => requestAnimationFrame(animate)));
    } else {
      requestAnimationFrame(() => requestAnimationFrame(animate));
    }

    const heroBg = document.getElementById('hero-bg-img') as HTMLImageElement | null;
    if (heroBg && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      const onScroll = () => {
        const scrollY = window.scrollY;
        const heroEl = document.getElementById('hero');
        if (!heroEl) return;
        if (scrollY > heroEl.offsetHeight) return;
        const pr = scrollY / heroEl.offsetHeight;
        heroBg.style.transform = `scale(1.15) translateY(${pr * 120}px)`;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    const counters = document.querySelectorAll<HTMLElement>('.hero-counter');
    counters.forEach((el) => {
      const suffix = el.dataset.suffix ?? '';
      const decimals = parseInt(el.dataset.decimal || '0', 10);
      el.textContent = (0).toFixed(decimals).replace('.', ',') + suffix;
    });
    const runCounter = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.target || '0');
      const suffix = el.dataset.suffix ?? '';
      const decimals = parseInt(el.dataset.decimal || '0', 10);
      const duration = 1400;
      const startTime = performance.now();
      const tick = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = eased * target;
        el.textContent = current.toFixed(decimals).replace('.', ',') + suffix;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    setTimeout(() => counters.forEach(runCounter), 750);
  })();

  // Trainingsroute: Füllstand + Wegpunkte beim Scrollen; Hero-Chips öffnen Symptom
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const journey = document.getElementById('journey');
    const route = document.getElementById('route');
    const fill = document.getElementById('routeFill');
    const head = document.getElementById('routeHead');
    const goal = document.getElementById('nodeGoal');
    if (!journey || !route || !fill || !head || !goal) return;

    const nodes = [...document.querySelectorAll<HTMLElement>('.node, .node-goal')];
    let routeH = 0;
    let nodePos: { el: HTMLElement; y: number }[] = [];

    const layout = () => {
      const jTop = journey.getBoundingClientRect().top + window.scrollY;
      const gRect = goal.getBoundingClientRect();
      routeH = gRect.top + window.scrollY + gRect.height * 0.72 - jTop;
      route.style.height = routeH + 'px';
      nodePos = nodes.map((n) => {
        const r = n.getBoundingClientRect();
        return { el: n, y: r.top + window.scrollY + r.height / 2 - jTop };
      });
    };

    let ticking = false;
    const tick = () => {
      ticking = false;
      if (!routeH) return;
      const jTop = journey.getBoundingClientRect().top;
      const target = window.innerHeight * 0.6;
      const filled = Math.min(Math.max(target - jTop, 0), routeH);
      const pr = filled / routeH;
      fill.style.transform = `scaleY(${pr})`;
      head.style.transform = `translate(-50%, ${filled}px)`;
      head.style.opacity = pr > 0.001 && pr < 0.999 ? '1' : '0';
      nodePos.forEach((n) => n.el.classList.toggle('lit', n.y <= filled + 4));
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(tick); } };

    if (!reduced) {
      layout(); tick();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => { layout(); tick(); }, { passive: true });
      window.addEventListener('load', () => { layout(); tick(); });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { layout(); tick(); });
      if (window.ResizeObserver) {
        const ro = new ResizeObserver(() => { layout(); tick(); });
        ro.observe(journey);
      }
    } else {
      layout();
      fill.style.transform = 'scaleY(1)';
      nodes.forEach((n) => n.classList.add('lit'));
    }

    // Hero-Chips: Ziel-Symptom aufklappen
    document.querySelectorAll<HTMLAnchorElement>('#hero-chips a[href^="#sym-"]').forEach((chip) => {
      chip.addEventListener('click', () => {
        const sel = chip.getAttribute('href');
        if (!sel) return;
        const t = document.querySelector(sel);
        if (t && t.tagName === 'DETAILS') (t as HTMLDetailsElement).open = true;
      });
    });
  })();
</script>
