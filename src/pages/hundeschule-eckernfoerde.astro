---
import Layout from "../layouts/Layout.astro";
import CityPage from "../components/CityPage.astro";

const features = [
  { bold: "Schnell bei dir in Eckernförde", text: "Kurze Anfahrt aus Bredenbek, ich bin flexibel bei dir vor Ort." },
  { bold: 'Experte für "schwierige Felle"', text: "Leinenpöbeln an der Promenade, Unsicherheit im Touristentrubel: Mit genau solchen Hunden arbeite ich jeden Tag." },
  { bold: "Training im Küsten-Alltag", text: "Wir üben dort, wo Eckernförde lebt: am Hafen, am Noor oder am Strand." },
  { bold: "Welpenstart mit Plan", text: "Dein Welpe lernt Hafen, Strand und Möwen kennen, bevor daraus ein Problem wird." },
  { bold: "Fit für den Alltag", text: "Leinenführigkeit und Rückruf so aufgebaut, dass sie auch am Hundestrand halten." },
];

const introParagraphs = [
  'Wohnst du in <strong>Eckernförde</strong> oder Umgebung und der entspannte Spaziergang am Wasser wird zur Zerreißprobe? Vielleicht zieht dein Hund an der Leine, sobald ihr euch dem Trubel am <strong>Hafen</strong> oder der <strong>Promenade</strong> nähert? Oder der Rückruf am <strong>Hundestrand</strong> funktioniert überhaupt nicht, sobald andere Hunde oder Möwen in Sicht sind?',
  'Mein Name ist <strong>René Pahlke</strong>, ich bin der Trainer hinter WolfsKnigge. Als dein mobiler <strong>Hundetrainer für Eckernförde</strong> weiß ich: Probleme wie Leinenaggression oder Jagdverhalten lösen wir nicht auf einem abgelegenen Hundeplatz im Binnenland. Dein Hund muss lernen, in <em>deinem</em> küstennahen Umfeld entspannt zu bleiben, zwischen Touristen, Radfahrern und Strand-Trubel. <em>Genau hier setze ich an.</em>',
  'Über <strong>300 Teams</strong> habe ich bisher begleitet, mein Schwerpunkt ist <strong>Problemverhalten</strong>. Egal ob dein Hund pöbelt, jagt oder unsicher ist, ich arbeite mit dir fair, gewaltfrei und nach den neuesten Erkenntnissen der Lerntheorie (alle 4 Quadranten).',
  '<strong>Der Vorteil:</strong> Von Bredenbek aus bin ich schnell an der Küste. Über die Landstraße bin ich ruckzuck bei dir in Eckernförde, Borby oder Altenhof. Wir trainieren in deinem realen Alltag, damit die Erfolge auch wirklich anhalten.',
];

const extraContent = [
  'Eckernförde ist klein, aber für Hunde mit Baustellen erstaunlich anspruchsvoll. Der Grund: die Saison. Von Frühjahr bis Herbst verwandeln Touristen den <strong>Hafen</strong> und die <strong>Promenade</strong> in einen Dauerreiz aus Menschen, Eisdielen, Fahrrädern und fremden Hunden auf engem Raum. Ein Hund, der im Februar entspannt am Wasser läuft, kann im Juli komplett überfordert sein. Genau deshalb trainieren wir saisonabhängig: ruhige Monate zum Aufbauen, volle Monate zum Festigen.',
  'Der <strong>Hundestrand</strong> ist Segen und Falle zugleich. Freilauf, Wasser, andere Hunde, dazu Möwen, die knapp über den Köpfen kreisen. Wenn der Rückruf nicht sitzt, wird aus der schönsten Ecke der Stadt schnell Kontrollverlust. Wir bauen ihn deshalb systematisch auf: erst auf reizarmen Flächen im Umland, dann am Strandrand mit Schleppleine, am Ende mitten im Trubel. Und wir klären, wie du mit Freilauf-Hunden umgehst, die ungefragt auf deinen angeleinten Hund zulaufen. Das ist am Strand die häufigste Eskalationssituation.',
  'Auf der anderen Seite der Bucht liegt <strong>Borby</strong>, und dort sieht der Alltag anders aus: Wohnstraßen, das ruhigere Borbyer Ufer, Begegnungen auf schmalen Gehwegen. Hier entstehen die typischen Leinenprobleme, weil man sich täglich denselben Hunden gegenübersteht und Ausweichen kaum möglich ist. Dazu kommt der Rundweg am <strong>Windebyer Noor</strong>: schöne Strecke, aber schmal, mit Radfahrern und Gegenverkehr. Perfekt, um Bogen laufen und ruhiges Passieren zu üben.',
  'Und wer etwas raus will: Richtung <strong>Altenhof</strong> und entlang der Steilküste wird es waldiger und wildreicher. Für jagdlich motivierte Hunde ist das die Prüfung, für uns das Trainingsgelände für Impulskontrolle und Orientierung am Menschen. Auch hier gilt: erst dort üben, wo dein Hund noch ansprechbar ist, dann die Anforderungen steigern.',
  'Auch außerhalb der Stadt bin ich unterwegs, etwa in <strong>Gettorf</strong>. Dort geht es ruhiger zu als an der Promenade, die Aufgaben sind trotzdem dieselben: Begegnungen an der Leine, ein Rückruf, der hält, ein Hund, der draußen ansprechbar bleibt. Wir legen die Basis auf deinen Wegen vor Ort und nehmen uns die Küste vor, wenn sie steht.',
  'Kurz gesagt: Eckernförde bietet auf wenigen Kilometern alles, vom leeren Winterstrand bis zur überfüllten Sommerpromenade. Ich komme zu dir, wir nutzen genau diese Bandbreite, und dein Hund lernt dort, wo ihr wirklich unterwegs seid. Nicht auf einem Platz im Binnenland.',
];

const ortsFaq = [
  { frage: "Kommen für Eckernförde Fahrtkosten dazu?", antwort: 'Bis 25 km Entfernung ab Bredenbek kostet dich die Anfahrt nichts. Darüber berechne ich 30 Cent pro gefahrenem Kilometer, für Hin- und Rückweg. Ob deine Adresse in Eckernförde, Borby oder Altenhof darüber liegt, sage ich dir vor dem ersten Termin.' },
  { frage: "Wo trainieren wir in Eckernförde?", antwort: 'Bei dir zuhause und dort, wo euer Alltag spielt: am Hafen, an der Promenade, am Windebyer Noor, am Hundestrand, in Borby und Altenhof. Auch Gettorf liegt in meinem Gebiet.' },
  { frage: "Gibt es in Eckernförde einen Welpenkurs oder eine Gruppe?", antwort: 'Direkt in Eckernförde nicht. Meine <a href="/welpengruppe/" class="underline decoration-orange/60 underline-offset-4 hover:text-orange">Welpengruppe</a> und die <a href="/grunderziehungsgruppe/" class="underline decoration-orange/60 underline-offset-4 hover:text-orange">Grunderziehungsgruppe</a> sind rund um Kiel und Rendsburg zuhause, die <a href="/junghundegruppe/" class="underline decoration-orange/60 underline-offset-4 hover:text-orange">Junghundegruppe</a> trifft sich unter anderem in Bredenbek. Für Hunde aus Eckernförde ist deshalb meist das Einzeltraining der richtige Weg, an Hafen, Strand oder Noor.' },
  { frage: "Wie komme ich in Eckernförde zu einem ersten Termin?", antwort: 'Eine WhatsApp oder ein Anruf reicht. Spätestens nach 24 Stunden melde ich mich bei dir, dann suchen wir zusammen einen Termin. Das erste Telefonat ist kostenlos und unverbindlich.' },
];
---

<Layout title="Hundeschule Eckernförde: Hundetrainer kommt zu dir" description="Leinenpöbeln, Angst oder kein Rückruf am Strand? René Pahlke trainiert mit dir in Eckernförde, Borby und am Noor. 5,0 Sterne, Kennenlernen kostenlos.">
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://wolfsknigge.de/#hundeschule",
    "name": "WolfsKnigge - Mobile Hundeschule",
    "url": "https://wolfsknigge.de/",
    "image": "https://wolfsknigge.de/images/og-default.webp",
    "priceRange": "$$",
    "telephone": "+4915147736042",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Katzheide 24",
      "addressLocality": "Bredenbek",
      "addressRegion": "Schleswig-Holstein",
      "postalCode": "24796",
      "addressCountry": "DE"
    },
    "areaServed": { "@type": "City", "name": "Eckernförde" }
  })} />
  <CityPage
    city="Eckernförde"
    title="Hundeschule Eckernförde: mobiles Training für <span>Problemverhalten</span> & Alltag"
    heroSubtitle="Schluss mit Stress an der Promenade. Ich komme zu dir nach Eckernförde und wir lösen das Problem dort, wo es entsteht."
    heroImage="/images/hundetraining_eckernförde.webp"
    features={features}
    introH2="Dein erfahrener mobiler Hundetrainer in Eckernförde"
    introParagraphs={introParagraphs}
    extraContent={extraContent}
    routeImage="/images/hundeschule_isz_am_strand-1600.webp"
    routeImageAlt="Social Walk mit Hunden am Strand von Eckernförde"
    ortsFaq={ortsFaq}
    anamneseText="Am Anfang steht die Bestandsaufnahme bei dir an der Küste. Daraus entsteht dein Trainingsplan für Eckernförde, Borby oder Altenhof."
    welpenText="Der beste Start für dich und deinen Welpen: Sozialisierung, Grunderziehung und Gewöhnung an das Stadt- und Strandleben."
  />
</Layout>
