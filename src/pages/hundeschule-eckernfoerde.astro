---
import Layout from "../layouts/Layout.astro";
import CityPage from "../components/CityPage.astro";

const features = [
  { bold: "Schnell bei dir in Eckernförde", text: "Kurze Anfahrt aus Bredenbek, ich bin flexibel bei dir vor Ort." },
  { bold: 'Experte für "schwierige Felle"', text: "Echte Hilfe bei Aggression & Leinenpöbelei (kein Hundeplatz-Schema-F)." },
  { bold: "Training im Küsten-Alltag", text: "Wir üben dort, wo Eckernförde lebt: am Hafen, am Noor oder am Strand." },
  { bold: "Welpenstart mit Plan", text: "Sozialisierung im echten Leben statt nur im eingezäunten Auslauf." },
  { bold: "Fit für den Alltag", text: "In kleinen Gruppen Leinenführigkeit, Rückruf & Co. meistern." },
];

const introParagraphs = [
  'Wohnst du in <strong>Eckernförde</strong> oder Umgebung und der entspannte Spaziergang am Wasser wird zur Zerreißprobe? Vielleicht zieht dein Hund an der Leine, sobald ihr euch dem Trubel am <strong>Hafen</strong> oder der <strong>Promenade</strong> nähert? Oder der Rückruf am <strong>Hundestrand</strong> funktioniert überhaupt nicht, sobald andere Hunde oder Möwen in Sicht sind?',
  'Ich bin <strong>René Pahlke</strong> von WolfsKnigge. Als dein mobiler <strong>Hundetrainer für Eckernförde</strong> weiß ich: Probleme wie Leinenaggression oder Jagdverhalten lösen wir nicht auf einem abgelegenen Hundeplatz im Binnenland. Dein Hund muss lernen, in <em>deinem</em> küstennahen Umfeld entspannt zu bleiben, zwischen Touristen, Radfahrern und Strand-Trubel. <em>Genau hier setze ich an.</em>',
  'Mit meiner Erfahrung aus über <strong>200 erfolgreich betreuten Kunden-Teams</strong> habe ich mich auf <strong>Problemverhalten</strong> spezialisiert. Egal ob dein Hund pöbelt, jagt oder unsicher ist, ich arbeite mit dir fair, gewaltfrei und nach den neuesten Erkenntnissen der Lerntheorie (alle 4 Quadranten).',
  '<strong>Der Vorteil:</strong> Ich starte direkt aus Bredenbek. Über die Landstraße bin ich ruckzuck bei dir in Eckernförde, Borby oder Altenhof. Wir trainieren in deinem realen Alltag, damit die Erfolge auch wirklich anhalten.',
];

const extraContent = [
  'Eckernförde ist klein, aber für Hunde mit Baustellen erstaunlich anspruchsvoll. Der Grund: die Saison. Von Frühjahr bis Herbst verwandeln Touristen den <strong>Hafen</strong> und die <strong>Promenade</strong> in einen Dauerreiz aus Menschen, Eisdielen, Fahrrädern und fremden Hunden auf engem Raum. Ein Hund, der im Februar entspannt am Wasser läuft, kann im Juli komplett überfordert sein. Genau deshalb trainieren wir saisonabhängig: ruhige Monate zum Aufbauen, volle Monate zum Festigen.',
  'Der <strong>Hundestrand</strong> ist Segen und Falle zugleich. Freilauf, Wasser, andere Hunde, dazu Möwen, die knapp über den Köpfen kreisen. Wenn der Rückruf nicht sitzt, wird aus der schönsten Ecke der Stadt schnell Kontrollverlust. Wir bauen ihn deshalb systematisch auf: erst auf reizarmen Flächen im Umland, dann am Strandrand mit Schleppleine, am Ende mitten im Trubel. Und wir klären, wie du mit Freilauf-Hunden umgehst, die ungefragt auf deinen angeleinten Hund zulaufen. Das ist am Strand die häufigste Eskalationssituation.',
  'Auf der anderen Seite der Bucht liegt <strong>Borby</strong>, und dort sieht der Alltag anders aus: Wohnstraßen, das ruhigere Borbyer Ufer, Begegnungen auf schmalen Gehwegen. Hier entstehen die typischen Leinenprobleme, weil man sich täglich denselben Hunden gegenübersteht und Ausweichen kaum möglich ist. Dazu kommt der Rundweg am <strong>Windebyer Noor</strong>: schöne Strecke, aber schmal, mit Radfahrern und Gegenverkehr. Perfekt, um Bogen laufen und ruhiges Passieren zu üben.',
  'Und wer etwas raus will: Richtung <strong>Altenhof</strong> und entlang der Steilküste wird es waldiger und wildreicher. Für jagdlich motivierte Hunde ist das die Prüfung, für uns das Trainingsgelände für Impulskontrolle und Orientierung am Menschen. Auch hier gilt: erst dort üben, wo dein Hund noch ansprechbar ist, dann die Anforderungen steigern.',
  'Kurz gesagt: Eckernförde bietet auf wenigen Kilometern alles, vom leeren Winterstrand bis zur überfüllten Sommerpromenade. Ich komme zu dir, wir nutzen genau diese Bandbreite, und dein Hund lernt dort, wo ihr wirklich unterwegs seid. Nicht auf einem Platz im Binnenland.',
];
---

<Layout title="Hundeschule Eckernförde – mobil bei dir | WolfsKnigge" description="Mobile Hundeschule Eckernförde: 200+ Teams, 5,0 auf Google. René Pahlke kommt zu dir – Hilfe bei Leinenaggression & Angst. Training am Noor & Strand.">
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://wolfsknigge.de/hundeschule-eckernfoerde/#localbusiness",
    "name": "WolfsKnigge - Mobile Hundeschule",
    "url": "https://wolfsknigge.de/hundeschule-eckernfoerde/",
    "image": "https://wolfsknigge.de/images/og-default.webp",
    "priceRange": "$$",
    "telephone": "+4915147736042",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Katzheide 24",
      "addressLocality": "Bredenbek",
      "addressRegion": "Schleswig-Holstein",
      "postalCode": "24796",
      "addressCountry": "DE"
    },
    "areaServed": { "@type": "City", "name": "Eckernförde" }
  })} />
  <CityPage
    city="Eckernförde"
    title="Mobiles Hundetraining Eckernförde. Dein Experte für <span>Problemverhalten</span> & Alltagstauglichkeit"
    heroSubtitle="Schluss mit Stress an der Promenade. Ich komme zu dir nach Eckernförde und wir lösen das Problem dort, wo es entsteht."
    heroImage="/images/hundetraining_eckernförde.webp"
    features={features}
    introH2="Dein erfahrener mobiler Hundetrainer in Eckernförde"
    introParagraphs={introParagraphs}
    extraContent={extraContent}
    routeImage="/images/hundeschule_isz_am_strand.webp"
    routeImageAlt="Hundeschule am Strand in Eckernförde"
    anamneseText="Der erste Schritt: ausführliche Bestandsaufnahme & individuelle Trainingsplanung. Direkt in Eckernförde, Borby & Altenhof."
    anamneseAlt="Hundetraining in Eckernförde an Aggressionsverhalten"
    einzelAlt="Leinenführig durch den Park in Altenholz"
    welpenText="Der beste Start für dich und deinen Welpen: Sozialisierung, Grunderziehung und Gewöhnung an das Stadt- und Strandleben."
    welpenAlt="Welpenschule am Hafen von Eckernförde"
    grundAlt="Gruppentraining im Windebyer Noor und Umgebung"
  />
</Layout>
