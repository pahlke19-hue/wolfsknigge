---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Danke für deine Buchung! | WolfsKnigge" description="Deine Buchung ist angekommen. Vor dem ersten Termin melde ich mich mit allen Details." noindex={true}>

  <section class="relative min-h-[90svh] flex items-center justify-center bg-anthrazit overflow-hidden noise">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(249,115,22,.15),transparent_60%)] pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] rounded-full blob-float pointer-events-none" style="background: rgba(249,115,22,.04);"></div>

    <div class="relative max-w-[600px] mx-auto px-5 text-center space-y-8">
      <div class="w-20 h-20 mx-auto rounded-full bg-orange/15 border border-orange/30 flex items-center justify-center text-orange text-4xl shadow-[0_0_60px_rgba(249,115,22,0.25)]">
        🐾
      </div>

      <div class="space-y-4">
        <h1 class="font-display font-extrabold text-4xl md:text-5xl text-white tracking-tight">
          Danke für deine <br/>
          <span class="text-gradient-orange">Buchung!</span>
        </h1>
        <p class="text-white/50 text-base leading-relaxed font-light">
          Deine Buchung ist bei mir angekommen. Vor dem ersten Termin melde ich mich bei dir, damit wir Treffpunkt und Ablauf abstimmen.
        </p>
        <p class="text-white/50 text-sm leading-relaxed font-light">
          Fragen vorab? Schreib mir per WhatsApp oder ruf an: <a href="tel:+4915147736042" class="text-orange font-medium hover:underline">0151 47736042</a>
        </p>
      </div>

      <div class="pt-4 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="https://wa.me/4915147736042?text=Hallo%20Ren%C3%A9%2C%0AAnliegen%3A%20%0AWohnort%3A%20%0AZeit%20f%C3%BCr%20Anruf/Termin%3A%20" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full bg-orange hover:bg-orange-dark text-white font-display font-semibold px-8 py-4 text-sm transition-all">
          Frage per WhatsApp
        </a>
        <a href="/" class="inline-flex items-center justify-center gap-2 rounded-full bg-white/5 border border-white/10 text-white font-display font-semibold px-8 py-4 text-sm transition-all hover:bg-white/10">
          Zurück zur Startseite
        </a>
      </div>
    </div>
  </section>

</Layout>
