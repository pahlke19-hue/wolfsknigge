---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Kontakt: René Pahlke – dein mobiler Hundetrainer" description="Hundetraining, das zu dir kommt. Schreib mir für ein individuelles Training in Kiel, Rendsburg, Eckernförde & Umgebung. Jetzt kostenlos anfragen.">

  <!-- HERO & INTRO -->
  <section class="relative pt-[88px] pb-8 md:pt-40 md:pb-16 bg-gradient-to-b from-black to-anthrazit overflow-hidden noise">
    <div class="absolute -top-[200px] right-[-100px] w-[600px] h-[600px] rounded-full pointer-events-none blob-float" style="background: radial-gradient(circle, rgba(249,115,22,.12), transparent 70%);"></div>
    <div class="absolute bottom-[-100px] left-[-100px] w-[500px] h-[500px] rounded-full pointer-events-none blob-float-rev" style="background: radial-gradient(circle, rgba(54,255,243,.04), transparent 70%);"></div>

    <div class="relative max-w-[1200px] mx-auto px-5 sm:px-8 lg:px-12 text-center">
      <img
        src="/images/rene_mit_tierschutzhund.webp"
        alt="René Pahlke mit Hund"
        width="112"
        height="112"
        class="mx-auto mb-3 w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover border-2 border-orange/40"
        style="object-position: 50% 28%;"
      />
      <span class="inline-block text-orange font-semibold uppercase text-[13px] tracking-[0.3em] mb-2">Lass uns reden</span>
      <h1 class="text-4xl md:text-6xl font-display font-extrabold text-white tracking-tight leading-[1.05] mb-3">
        Kostenloses<br/>
        <span class="text-gradient-orange">Kennenlernen.</span>
      </h1>
      <p class="text-[clamp(1rem,2vw,1.25rem)] text-white/60 max-w-[700px] mx-auto leading-relaxed font-light mb-5">
        Erzähl mir kurz, was bei euch los ist. Ich lese jede Nachricht selbst und melde mich meistens innerhalb von 24 Stunden. Das erste Telefongespräch ist kostenlos und unverbindlich.
      </p>
      <div class="flex flex-col sm:flex-row items-stretch sm:justify-center gap-3 max-w-[520px] sm:max-w-none mx-auto">
        <a
          href="https://wa.me/4915147736042?text=Hallo%20Ren%C3%A9%2C%0AAnliegen%3A%20%0AWohnort%3A%20%0AZeit%20f%C3%BCr%20Anruf/Termin%3A%20"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-white font-display font-semibold px-7 py-4 text-base shadow-[0_4px_20px_rgba(37,211,102,0.35)] transition-all active:scale-95"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.117 1.528 5.845L.057 23.428a.5.5 0 0 0 .614.614l5.638-1.47A11.934 11.934 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.797 9.797 0 0 1-5.003-1.376l-.36-.214-3.724.97.993-3.63-.234-.374A9.797 9.797 0 0 1 2.182 12C2.182 6.573 6.573 2.182 12 2.182S21.818 6.573 21.818 12 17.427 21.818 12 21.818z"/>
          </svg>
          WhatsApp schreiben
        </a>
        <a
          href="tel:+4915147736042"
          class="inline-flex items-center justify-center gap-2.5 rounded-full bg-orange hover:bg-orange-dark text-white font-display font-semibold px-7 py-4 text-base shadow-[0_4px_20px_rgba(249,115,22,0.35)] transition-all active:scale-95"
        >
          <svg class="w-5 h-5 fill-none stroke-current" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Anrufen: 0151 47736042
        </a>
      </div>
      <p class="mt-4 text-sm text-white/60 flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
        <a href="#formular" class="text-orange underline underline-offset-2 hover:text-orange-glow">Lieber schreiben? Zum Formular</a>
        <a href="mailto:kontakt@wolfsknigge.de" class="text-white/60 underline underline-offset-2 hover:text-white">kontakt@wolfsknigge.de</a>
      </p>
    </div>
  </section>

  <!-- FORM & INFO SECTION -->
  <section class="py-12 md:py-24 bg-anthrazit relative overflow-hidden">
    <div class="max-w-[1200px] mx-auto px-5 sm:px-8 lg:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Linke Spalte: So geht es weiter + Einsatzgebiet -->
      <div class="order-2 lg:order-1 lg:col-span-5 space-y-8 reveal">
        <div class="bg-anthrazit-2 border border-white/5 rounded-3xl p-8 space-y-6">
          <h2 class="font-display font-bold text-2xl text-white">So geht es weiter</h2>
          <ol class="space-y-5">
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-orange/10 border border-orange/30 text-orange font-display font-bold text-sm flex items-center justify-center">1</span>
              <p class="text-white/60 text-[15px] leading-relaxed pt-0.5">Ich lese deine Nachricht. Selbst, nicht irgendein Büro.</p>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-orange/10 border border-orange/30 text-orange font-display font-bold text-sm flex items-center justify-center">2</span>
              <p class="text-white/60 text-[15px] leading-relaxed pt-0.5">Ich melde mich bei dir, meistens innerhalb von 24 Stunden. Am liebsten per Telefon, dann klärt sich vieles schneller.</p>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-orange/10 border border-orange/30 text-orange font-display font-bold text-sm flex items-center justify-center">3</span>
              <p class="text-white/60 text-[15px] leading-relaxed pt-0.5">Wir besprechen kostenlos, was bei euch los ist und ob ich der Richtige für euch bin.</p>
            </li>
          </ol>
        </div>

        <div class="bg-anthrazit-2 border border-white/5 rounded-3xl p-8 space-y-4">
          <h3 class="font-display font-bold text-lg text-white">📍 Einsatzgebiet</h3>
          <p class="text-white/50 text-[14px] leading-relaxed">
            Als mobile Hundeschule komme ich direkt zu dir. Ich bin in einem Umkreis von ca. <strong class="text-white">35 km rund um Bredenbek</strong> unterwegs.
          </p>
          <div class="flex flex-wrap gap-2 pt-2">
            {["Kiel", "Rendsburg", "Eckernförde", "Neumünster", "Fockbek", "Kronshagen", "Büdelsdorf", "Altenholz"].map((ort) => (
              <span class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-white/5 border border-white/8 text-white/60">{ort}</span>
            ))}
          </div>
          <p class="text-[12px] text-white/30 italic pt-1">
            * Anfahrt bis 25 km ab Bredenbek kostenfrei, darüber 0,30 € pro gefahrenem Kilometer (Hin- und Rückfahrt).
          </p>
        </div>
      </div>

      <!-- Rechte Spalte: Kontaktformular -->
      <div class="order-1 lg:order-2 lg:col-span-7 reveal reveal-delay-1">
        <div id="formular" class="scroll-mt-24 bg-anthrazit-2 border border-white/5 rounded-3xl p-8 md:p-10 shadow-2xl relative">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-orange to-orange-dark"></div>

          <h2 class="font-display font-bold text-2xl md:text-3xl text-white mb-8">Oder schreib mir hier</h2>

          <!-- Formular mit Netlify Integration -->
          <form name="kontakt" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-6" action="/thanks-formular/">
            <input type="hidden" name="form-name" value="kontakt" />
            <input type="hidden" name="herkunft" value="" />
            <p class="hidden" aria-hidden="true">
              <label>Bitte dieses Feld leer lassen: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-[13px] font-semibold text-white/60 mb-2 uppercase tracking-wider">Dein Name *</label>
                <input
                  type="text"
                  name="name"
                  id="name"
                  required
                  placeholder="Max Mustermann"
                  class="w-full bg-white/3 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-white/20 focus:outline-none focus:border-orange/50 transition-colors text-sm"
                />
              </div>
              <div>
                <label for="ort" class="block text-[13px] font-semibold text-white/60 mb-2 uppercase tracking-wider">Wohnort & Ortsteil</label>
                <input
                  type="text"
                  name="ort"
                  id="ort"
                  placeholder="Kiel, Schreventeich"
                  class="w-full bg-white/3 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-white/20 focus:outline-none focus:border-orange/50 transition-colors text-sm"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="phone" class="block text-[13px] font-semibold text-white/60 mb-2 uppercase tracking-wider">Telefonnummer (für den Rückruf)</label>
                <input
                  type="tel"
                  name="phone"
                  id="phone"
                  placeholder="0151 1234567"
                  class="w-full bg-white/3 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-white/20 focus:outline-none focus:border-orange/50 transition-colors text-sm"
                />
              </div>
              <div>
                <label for="email" class="block text-[13px] font-semibold text-white/60 mb-2 uppercase tracking-wider">E-Mail-Adresse *</label>
                <input
                  type="email"
                  name="email"
                  id="email"
                  required
                  placeholder="deine-mail@adresse.de"
                  class="w-full bg-white/3 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-white/20 focus:outline-none focus:border-orange/50 transition-colors text-sm"
                />
              </div>
            </div>

            <div>
              <label for="erreichbarkeit" class="block text-[13px] font-semibold text-white/60 mb-2 uppercase tracking-wider">Wann bist du telefonisch gut erreichbar?</label>
              <input
                type="text"
                name="erreichbarkeit"
                id="erreichbarkeit"
                placeholder="z.B. werktags ab 17 Uhr"
                class="w-full bg-white/3 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-white/20 focus:outline-none focus:border-orange/50 transition-colors text-sm"
              />
            </div>

            <div class="border-t border-white/5 pt-6">
              <label for="message" class="block text-[13px] font-semibold text-white/60 mb-2 uppercase tracking-wider">Worum geht es? *</label>
              <textarea
                name="message"
                id="message"
                rows="4"
                required
                placeholder="Beschreib kurz euer Anliegen (z.B. Leinenpöbeln, Angst, Welpenstart)."
                class="w-full bg-white/3 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-white/20 focus:outline-none focus:border-orange/50 transition-colors text-sm leading-relaxed"
              ></textarea>
            </div>

            <p class="text-xs text-white/55 leading-relaxed">
              Mit dem Absenden willigst du in die Verarbeitung deiner Daten zur Kontaktaufnahme ein. Details findest du in der <a href="/dsgvo/" target="_blank" rel="noopener" class="text-orange underline hover:text-orange-glow">Datenschutzerklärung</a>.
            </p>

            <button
              type="submit"
              class="shine w-full inline-flex items-center justify-center gap-2.5 rounded-full bg-orange hover:bg-orange-dark text-white font-display font-semibold px-8 py-4 text-base transition-all shadow-[0_0_40px_rgba(249,115,22,0.25)] active:scale-98 cursor-pointer"
            >
              Nachricht an René senden
              <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
            <p class="text-center text-xs text-white/55 leading-relaxed -mt-2">Kostenlos und unverbindlich. Antwort meist innerhalb von 24 Stunden.</p>
          </form>
        </div>
      </div>

    </div>
  </section>

  <script is:inline>
    (function () {
      try {
        var f = document.forms["kontakt"];
        if (!f || !f.elements["herkunft"]) return;
        var src = "direkt";
        var ref = document.referrer || "";
        if (ref) {
          var u = new URL(ref);
          src = u.hostname === location.hostname ? u.pathname : u.hostname;
        }
        var ad = /[?&#](gclid|gbraid|wbraid)=/i.test(ref + "&" + location.search + location.hash);
        f.elements["herkunft"].value = src + " | Anzeige: " + (ad ? "ja" : "nein");
      } catch (e) {}
    })();
  </script>

</Layout>
