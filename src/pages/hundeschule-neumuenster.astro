---
import Layout from "../layouts/Layout.astro";
import CityPage from "../components/CityPage.astro";

const features = [
  { bold: "Schnell bei dir in Neumünster", text: "Kurze Anfahrt aus Bredenbek, wir starten direkt bei dir vor der Haustür." },
  { bold: 'Experte für "schwierige Felle"', text: "Pöbeln am Einfelder See, Jagen im Stadtwald, Stress am Großflecken: Das sind die Hunde, mit denen ich arbeite." },
  { bold: "Training im realen Umfeld", text: "Wir üben dort, wo Neumünster lebt: am See, im Stadtwald oder in der City." },
  { bold: "Welpenstart mit Plan", text: "Busse, Marktstände, Radfahrer: Dein Welpe lernt die Stadt kennen, bevor sie ihn überfordert." },
  { bold: "Fit für den Alltag", text: "Rückruf und Leinenführung, die im Viertel genauso halten wie am See." },
];

const introParagraphs = [
  'Wohnst du in <strong>Neumünster</strong> oder Umgebung und jeder Spaziergang fühlt sich an wie ein Spießrutenlauf? Vielleicht zieht dein Hund an der Leine, sobald ihr für die Runde am <strong>Einfelder See</strong> aus dem Auto steigt, oder er reagiert aggressiv auf andere Hunde, wenn es auf den Wegen im <strong>Stadtwald</strong> oder rund um den <strong>Großflecken</strong> eng wird.',
  'Hinter WolfsKnigge stehe ich, <strong>René Pahlke</strong>. Als dein mobiler <strong>Hundetrainer für Neumünster</strong> weiß ich: Echte Verhaltensprobleme lassen sich nicht auf einem eingezäunten Hundeplatz am Stadtrand "wegtrainieren". Sitz und Platz funktionieren dort oft perfekt, aber sobald der echte Alltag mit Verkehr, Joggern und anderen Hunden beginnt, ist der Gehorsam weg. <em>Genau hier setze ich an.</em>',
  '<strong>Problemverhalten</strong> ist mein Fachgebiet, über <strong>300 Teams</strong> haben schon mit mir trainiert. Leinenaggression, Angst, Stress oder fehlende Beißhemmung: Wir gehen es fair und gewaltfrei an, auf Basis der Lerntheorie mit allen 4 Quadranten.',
  '<strong>Der Vorteil:</strong> Ich komme aus Bredenbek direkt zu dir. Über die A7 bin ich in rund einer halben Stunde vor Ort. Trainiert wird in deinem Viertel in Neumünster, denn dort soll dein Hund später entspannt bleiben.',
];

const extraContent = [
  'Der <strong>Einfelder See</strong> ist für viele Neumünsteraner die Standardrunde, und genau da liegt das Problem: Im Sommer teilst du dir den Weg mit Badegästen, Radfahrern, freilaufenden Hunden und Wasservögeln direkt am Ufer. Ein Hund, der jagt oder an der Leine pöbelt, findet hier alle fünfzig Meter einen Auslöser. Wir nutzen das gezielt. Erst mit großem Abstand auf den offenen Flächen, dann immer näher am Weg, bis die Seerunde wieder Erholung ist statt Spießrutenlauf.',
  'Im <strong>Stadtwald</strong> sieht die Aufgabe anders aus. Schmale Wege, schlechte Sicht, Jogger und Mountainbiker, die plötzlich hinter der Kurve auftauchen, dazu Wildgeruch an jeder zweiten Ecke. Das ist klassisches Gelände für Jagdverhalten und Schreckreaktionen. Hier arbeiten wir an einem Rückruf mit Substanz und an einer Leinenführung, die auch dann hält, wenn ein Reh über den Weg wechselt. Wer es ruhiger braucht, mit dem starte ich am <strong>Dosenmoor</strong>, wo wir Reize viel besser dosieren können.',
  'Mitten in der Stadt wartet die dritte Baustelle: der <strong>Großflecken</strong> mit Bussen, Marktständen und Menschentrauben, dazu die Fußgängerzone und an Wochenenden der Besucherverkehr rund ums Outlet. Viele Halter meiden die Innenstadt irgendwann komplett, weil der Hund dort nicht mehr ansprechbar ist. Dabei ist genau das trainierbar, wenn man die Reizdichte kontrolliert aufbaut statt den Hund einfach durchzuschleifen.',
  'Und dann sind da die Wohnviertel selbst. In <strong>Faldera</strong>, <strong>Tungendorf</strong>, <strong>Wittorf</strong> und <strong>Gadeland</strong> entstehen die meisten Alltagsprobleme: Zaunbeller, enge Gehwege, immer dieselben Begegnungen mit immer denselben Hunden. Weil sich diese Situationen täglich wiederholen, verfestigen sie sich schnell. Der Vorteil: Wir können sie genauso systematisch wieder auflösen, weil wir genau wissen, wann und wo sie auftreten.',
  'Neumünster liegt am südlichen Rand meines Einzugsgebiets. Auch <strong>Bordesholm</strong> gehört dazu, dort trainieren wir genauso auf deinen eigenen Wegen. Typisch für Neumünster ist der Wechsel zwischen sehr ruhigen und sehr vollen Orten. Morgens das stille <strong>Dosenmoor</strong>, nachmittags der volle Großflecken: Für deinen Hund liegen dazwischen Welten. Genau diesen Wechsel nutzen wir im Training. Was im Dosenmoor sitzt, nehmen wir mit an den Einfelder See und später in die Innenstadt. Jeder Ort ist eine Stufe, und wir gehen erst weiter, wenn dein Hund die vorige sicher schafft. Klappt eine Stufe noch nicht, gehen wir einen Schritt zurück, ohne Druck. Am Ende ist die Innenstadt kein Ort mehr, den ihr meiden müsst. Das gilt für deinen Hund genauso wie für dich.',
  'Deshalb trainiere ich in Neumünster nicht auf einem Platz am Stadtrand, sondern auf euren Wegen. Ich komme in dein Viertel, wir gehen eure Route, und du bekommst an jeder kritischen Stelle einen konkreten Handlungsplan. Schritt für Schritt, vom machbaren Ort zum schwierigen.',
];

const ortsFaq = [
  { frage: "Was zahle ich für die Fahrt nach Neumünster?", antwort: 'Frei sind die ersten 25 km ab Bredenbek, jeder weitere Kilometer kostet 30 Cent, gerechnet für Hin- und Rückweg. Den Betrag für deine Adresse in Faldera, Tungendorf oder Wittorf bekommst du von mir vorab.' },
  { frage: "Wo trainieren wir in Neumünster?", antwort: 'Bei dir zuhause und dort, wo euer Alltag spielt: am Einfelder See, im Stadtwald, im Dosenmoor und in der City rund um den Großflecken. Ich komme nach Faldera, Gadeland, Tungendorf und Wittorf, auch nach Bordesholm.' },
  { frage: "Kann ich mit meinem Hund aus Neumünster in eine Gruppe?", antwort: 'Eine eigene Gruppe in Neumünster gibt es nicht. <a href="/welpengruppe/" class="underline decoration-orange/60 underline-offset-4 hover:text-orange">Welpengruppe</a> und <a href="/grunderziehungsgruppe/" class="underline decoration-orange/60 underline-offset-4 hover:text-orange">Grunderziehungsgruppe</a> laufen rund um Kiel und Rendsburg. Für Neumünsteraner Hunde heißt das meistens Einzeltraining, bei dir zuhause, am See oder in der Innenstadt.' },
  { frage: "Wann kann das Training in Neumünster losgehen?", antwort: 'Sobald du dich gemeldet hast, per WhatsApp oder am Telefon. Eine Antwort bekommst du binnen 24 Stunden, danach planen wir den Start bei dir in Neumünster. Für das erste Gespräch zahlst du nichts.' },
];
---

<Layout title="Hundeschule Neumünster: Hundetrainer kommt zu dir" description="Leinenpöbeln, Angst oder kein Rückruf? René Pahlke trainiert mit dir in Neumünster, am Einfelder See und im Stadtwald. 5,0 Sterne, Kennenlernen kostenlos.">
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://wolfsknigge.de/#hundeschule",
    "name": "WolfsKnigge - Mobile Hundeschule",
    "url": "https://wolfsknigge.de/",
    "image": "https://wolfsknigge.de/images/og-default.webp",
    "priceRange": "$$",
    "telephone": "+4915147736042",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Katzheide 24",
      "addressLocality": "Bredenbek",
      "addressRegion": "Schleswig-Holstein",
      "postalCode": "24796",
      "addressCountry": "DE"
    },
    "areaServed": { "@type": "City", "name": "Neumünster" }
  })} />
  <CityPage
    city="Neumünster"
    title="Hundeschule Neumünster: mobiles Training für <span>Problemverhalten</span> & Alltag"
    heroSubtitle="Schluss mit Stress an der Leine. Ich komme zu dir nach Neumünster und wir lösen das Problem dort, wo es entsteht."
    heroImage="/images/hundetraining_in_neumuenster.webp"
    features={features}
    introH2="Dein erfahrener mobiler Hundetrainer in Neumünster"
    introParagraphs={introParagraphs}
    extraContent={extraContent}
    routeImage="/images/hundetraining_am_nok-1200.webp"
    routeImageAlt="Gruppentraining am Wasser"
    ortsFaq={ortsFaq}
    anamneseText="Bevor wir trainieren, schaue ich mir euren Alltag genau an. Danach steht dein Plan, direkt in Neumünster, Faldera oder Gadeland."
    welpenText="Der beste Start für dich und deinen Welpen: Sozialisierung, Grunderziehung und Gewöhnung an das Stadtleben."
  />
</Layout>
